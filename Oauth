# ===============================
# Common Configuration
# ===============================
$scopeValue   = '${SF_SCOPE}'
$clientId     = '${SNOWFLAKE_OAUTH_DML_ID}'
$clientSecret = '${SNOWFLAKE_OAUTH_DML_SECRET}'
$tokenUrl     = '${SF_TOKEN_URL}'

$schedulerHost = '${ACTIVEBATCH_SERVER}'
$objectID      = '${AB_OBJECT_ID}'

$executionMachine = "${@ExecutionMachine}${EXECUTION_MACHINE_ENDING}"

$MAX_OAUTH_RETRIES = 3
$RETRY_DELAY_SEC  = 5

# ===============================
# Function: Get OAuth Token (with retry)
# ===============================
function Get-SnowflakeOAuthToken {

    $body = "grant_type=client_credentials&client_id=$clientId&client_secret=$clientSecret&scope=$scopeValue"

    for ($attempt = 1; $attempt -le $MAX_OAUTH_RETRIES; $attempt++) {
        try {
            $response = Invoke-RestMethod `
                -Method Post `
                -Uri $tokenUrl `
                -ContentType "application/x-www-form-urlencoded" `
                -Body $body

            if (-not [string]::IsNullOrEmpty($response.access_token)) {
                return $response.access_token
            }

            throw "Empty OAuth token returned"
        }
        catch {
            Write-Output "OAuth attempt $attempt failed: $($_.Exception.Message)"

            if ($attempt -eq $MAX_OAUTH_RETRIES) {
                throw "Failed to obtain OAuth token after $MAX_OAUTH_RETRIES attempts"
            }

            Start-Sleep -Seconds $RETRY_DELAY_SEC
        }
    }
}

# ===============================
# Function: Execute SnowSQL
# ===============================
function Run-SnowSqlQuery {
    param (
        [Parameter(Mandatory)]
        [string]$SqlQuery,

        [Parameter(Mandatory)]
        [string]$OAuthToken
    )

    Invoke-Command -ComputerName $executionMachine -ScriptBlock {
        param ($SqlQuery, $OAuthToken)

        snowsql -q $SqlQuery `
            -a "${SNOWFLAKE_ORGANIZATION_NAME}" `
            -r "${Snowflake_Role}" `
            -w "${Snowflake_Warehouse}" `
            -d "${Snowflake_Database}" `
            -s "${Snowflake_Schema}" `
            --authenticator=oauth `
            --token="$OAuthToken" 2>&1

    } -ArgumentList $SqlQuery, $OAuthToken
}

# ===============================
# Function: Update ActiveBatch Variable
# ===============================
function Update-ActiveBatchVariable {
    param (
        [Parameter(Mandatory)]
        [string]$VariableName,

        [Parameter(Mandatory)]
        [string]$Value
    )

    $jss = New-Object -ComObject "ActiveBatch.AbatJobScheduler"
    $jss.Connect($schedulerHost)

    $object = $jss.GetAbatObject($objectID)
    $vars   = $object.GetVariables()

    foreach ($var in $vars) {
        if ($var.Name -eq $VariableName) {
            $var.Value = $Value
            $object.Update()
            break
        }
    }
}

# ===============================
# Wrapper Function (ONE place to run everything)
# ===============================
function Execute-SnowflakeJob {
    param (
        [Parameter(Mandatory)]
        [string]$SqlQuery,

        [Parameter(Mandatory)]
        [string]$ActiveBatchVariable,

        [int]$SleepSeconds = 10
    )

    $token  = Get-SnowflakeOAuthToken
    $result = Run-SnowSqlQuery `
                -SqlQuery $SqlQuery `
                -OAuthToken $token

    Update-ActiveBatchVariable `
        -VariableName $ActiveBatchVariable `
        -Value $result

    Start-Sleep -Seconds $SleepSeconds
}

